DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@POOLED_HOST/neondb?sslmode=require
# Optional direct Neon connection. The app prefers this when the branch pooler is disabled.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Hostinger SMTP for reservation notifications
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=connect@namchekitchen.ca
SMTP_PASSWORD=your-hostinger-mailbox-password
RESERVATION_EMAIL_FROM=connect@namchekitchen.ca
RESERVATION_OWNER_EMAIL=namcheottawa@gmail.com

# Server-only Groq key. Never prefix this with NEXT_PUBLIC_.
GROQ_API_KEY=gsk_your_groq_key_here
# Optional comma-separated fallback order.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Server-only secret used to sign owner AI write proposals.
AI_CONFIRMATION_SECRET=replace_with_a_long_random_secret

# Owner AI prefers OpenRouter free models, then falls back to Groq above.
OPENROUTER_API_KEY=sk-or-v1_your_openrouter_key_here
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,openrouter/free
